{
  "fixtureTenantId": 9001,
  "fixtureTenantBId": 9002,
  "note": "Seeded fixture IDs only — never treat production counts as universal expected answers.",
  "cases": [
    {
      "id": "vehicle_count",
      "question": "How many vehicles do I have?",
      "expectedTools": ["get_vehicle_count"],
      "fixtureToolPayload": "{\"tenantId\":9001,\"count\":7,\"source\":\"fixture\"}",
      "expectedAnswerContains": ["7"],
      "expectedAnswerMustNotContain": ["999", "tenant 9002"],
      "source": "MCP get_vehicle_count over fixture inventory",
      "calculation": "COUNT(*) WHERE TenantId=@tenant from seeded Vehicles"
    },
    {
      "id": "vehicle_status",
      "question": "What is my fleet status breakdown?",
      "expectedTools": ["get_fleet_inventory_summary"],
      "fixtureToolPayload": "{\"tenantId\":9001,\"active\":5,\"maintenance\":1,\"inactive\":1,\"total\":7}",
      "expectedAnswerContains": ["5", "7"],
      "expectedAnswerMustNotContain": ["fabricated"],
      "source": "MCP get_fleet_inventory_summary",
      "calculation": "Group by status from seeded Vehicles"
    },
    {
      "id": "maintenance_due",
      "question": "Which vehicles need maintenance?",
      "expectedTools": ["get_maintenance_due"],
      "fixtureToolPayload": "{\"tenantId\":9001,\"due\":[{\"reg\":\"FIX-001\",\"dueInDays\":3}],\"count\":1}",
      "expectedAnswerContains": ["FIX-001"],
      "expectedAnswerMustNotContain": ["PROD-"],
      "source": "MCP get_maintenance_due",
      "calculation": "Due date <= today+window from seeded MaintenanceSchedules"
    },
    {
      "id": "fuel_period",
      "question": "Fuel costs this month",
      "expectedTools": ["get_fuel_cost_summary"],
      "fixtureToolPayload": "{\"tenantId\":9001,\"period\":\"fixture-month\",\"totalCost\":1250.50,\"currency\":\"SAR\"}",
      "expectedAnswerContains": ["1250"],
      "expectedAnswerMustNotContain": ["password", "apiKey"],
      "source": "MCP get_fuel_cost_summary",
      "calculation": "SUM(Amount) for fixture period"
    },
    {
      "id": "trip_summary",
      "question": "Summarize trips this week",
