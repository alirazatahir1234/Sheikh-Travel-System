# OS
.DS_Store
Thumbs.db

# Cursor agent / debug session logs (never commit)
.cursor/*.log
.cursor/debug-*.log
.cursor/debug-*.ndjson

# Android / Play signing material (never commit)
*.jks
*.keystore
**/key.properties
**/service-account*.json

# Backend local secrets / environment overlays (never commit)
**/appsettings.Development.json
**/appsettings.Local.json
.env
.env.*
# ASP.NET Data Protection key ring (tracking-token Unprotect / cookies)
**/dp-keys/
# Vercel CLI prebuilt output — must not be committed (see deploy/vercel/deploy-frontends.sh).
.vercel/
secrets/
secrets/**
docker-compose.db.env
appsettings.Production.json
appsettings.Staging.json
**/secrets.json
*.pfx

# Frontend build output and dependencies
**/node_modules/
**/dist/
**/.angular/
**/build/
**/.dart_tool/
**/ios/Pods/
**/ios/Pods/

# Release builds and large media — never commit
*.aab
*.apk
*.ipa
*.keystore
**/releases/
docs/marketing/**/*.mp4
docs/marketing/**/*.mov
