<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>SheikhGo Tracking</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>SheikhGo Tracking</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>SheikhGo Tracking needs your location to navigate trips and share live GPS with dispatch.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>SheikhGo Tracking needs background location to keep trip tracking active while the app is minimized or the screen is locked.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>SheikhGo Tracking needs background location to keep trip tracking active while the app is minimized or the screen is locked.</string>
		<key>NSLocalNetworkUsageDescription</key>
		<string>SheikhGo Tracking uses the local network to communicate with company servers and printers when needed.</string>
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsLocalNetworking</key>
			<true/>
			<!-- Prod mobile default is http://20.174.1.230:5082 (Fleet parity).
			     IP exceptions are best-effort on iOS; prefer api.sheikhgo.com HTTPS later. -->
			<key>NSExceptionDomains</key>
			<dict>
				<key>20.174.1.230</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
					<key>NSIncludesSubdomains</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<key>NSCameraUsageDescription</key>
		<string>SheikhGo Tracking needs the camera to capture fuel receipts, inspection photos, and compliance documents.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>SheikhGo Tracking needs photo library access to attach fuel receipts, inspection photos, and documents.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>SheikhGo Tracking may save captured receipts or inspection photos to your library when you choose to.</string>
		<key>NSFaceIDUsageDescription</key>
		<string>SheikhGo Tracking uses Face ID to unlock the app when biometric lock is enabled.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>SheikhGo Tracking uses the microphone for hands-free voice commands to dispatch and voice questions to the SheikhGo AI Assistant.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>SheikhGo Tracking converts your speech to text for alerts, messages to dispatch, and AI Assistant questions.</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>fetch</string>
			<string>remote-notification</string>
			<string>processing</string>
		</array>
		<key>GMSApiKey</key>
		<string>$(GOOGLE_MAPS_API_KEY)</string>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>comgooglemaps</string>
			<string>waze</string>
			<string>googlechromes</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
