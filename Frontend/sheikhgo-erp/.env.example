# Copy to .env.local (gitignored) for local ng serve / build:prod.
# Or set the same names in repo-root secrets/local.env (also gitignored).
# Never commit real values. Browser Maps keys are still visible in the SPA after build —
# protect them with HTTP referrer restrictions in Google Cloud Console:
#   http://localhost:4200/*  http://127.0.0.1:4200/*
#   https://sheikhgo.com/*   https://www.sheikhgo.com/*

# Required for Maps (Places autocomplete, routing, live map)
GOOGLE_MAPS_API_KEY=

# Optional Map ID for Advanced Markers
GOOGLE_MAPS_MAP_ID=

# Optional GA4 measurement ID (e.g. G-XXXXXXXXXX)
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Optional Plausible site hostname only (e.g. www.sheikhgo.com) — not a secret
PLAUSIBLE_DOMAIN=

# Optional self-hosted Plausible script URL (default: https://plausible.io/js/script.js)
PLAUSIBLE_SCRIPT_SRC=

# Optional Geoapify browser key (geofence editor place search). In Geoapify, allow only your sites.
GEOAPIFY_API_KEY=
