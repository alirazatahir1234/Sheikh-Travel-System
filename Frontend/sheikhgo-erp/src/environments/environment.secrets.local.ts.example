/**
 * Local Maps secrets — copy to environment.secrets.local.ts (gitignored).
 *
 *   cp src/environments/environment.secrets.local.ts.example \
 *      src/environments/environment.secrets.local.ts
 *
 * Then paste your browser Maps key. Restrict the key in Google Cloud Console:
 *   HTTP referrers: http://localhost:4200/*, http://127.0.0.1:4200/*,
 *                   https://sheikhgo.com/*, https://www.sheikhgo.com/*
 *
 * Enable: Maps JavaScript API, Places API, Geocoding API, Routes API.
 * Browser keys are visible in the SPA bundle by design — referrer + API restrictions are the control.
 *
 * Do not commit environment.secrets.local.ts.
 */
export const mapsSecrets = {
  googleMapsApiKey: '',
  googleMapsMapId: '',
  googleAnalyticsMeasurementId: '',
};
